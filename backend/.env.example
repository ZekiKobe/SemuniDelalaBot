# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Local dev: npm run dev
#
# Production VPS: scripts/vps-setup.sh → backend/.env → nginx → scripts/vps-deploy.sh
# Default deploy: API (delala-api) + bot (delala-bot) via ecosystem.config.js
# GitHub Actions: .github/workflows/deploy-vps.yml (DEPLOY_MODE=full)

# MongoDB (use Atlas on VPS — do not run Mongo on 1GB RAM)
MONGODB_URI=mongodb://localhost:27017/delala
MONGODB_DB_NAME=delala

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d 

# Upload — VPS production paths (match nginx /uploads alias)
UPLOAD_DIR=./uploads
# UPLOAD_DIR=/var/www/delala/uploads
MAX_FILE_SIZE=5242880
MAX_IMAGES_PER_PROPERTY=20
MIN_IMAGES_PER_PROPERTY=0

# Telegram
TELEGRAM_BOT_TOKEN=
# Channel users must join. The bot MUST be an administrator of this channel
# or membership checks fail with "member list is inaccessible".
TELEGRAM_CHANNEL_ID=@semunidelala
TELEGRAM_CHANNEL_URL=https://t.me/semunidelala
TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_SKIP_CHANNEL_CHECK=true   # local dev only

# Firebase (FCM)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Payment
LISTING_FEE_ETB=20
LISTING_DURATION_DAYS=90
TELEBIRR_ACCOUNT_NUMBER=0993676861
TELEBIRR_ACCOUNT_NAME=Zekarias
CBE_ACCOUNT_NUMBER=1000262694392
CBE_ACCOUNT_NAME=Zekarias Kobot Koyra

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
# VPS production example:
# API_URL=http://203.0.113.10
CORS_ORIGINS=http://localhost:3000,http://localhost:5584,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
# VPS production:
# LOG_DIR=/opt/delala/backend/logs
