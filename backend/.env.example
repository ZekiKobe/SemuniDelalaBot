# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Docker
# Development:  docker compose -f docker-compose.dev.yml up --build
# Production:   docker compose -f docker-compose.prod.yml up -d --build
# Dev compose sets MONGODB_URI to mongodb://mongo:27017/delala automatically.
# Prod compose uses MONGODB_URI from this file (set your Atlas URL).

# MongoDB
MONGODB_URI=mongodb://localhost:27017/delala
MONGODB_DB_NAME=delala

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d 

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
MAX_IMAGES_PER_PROPERTY=20
MIN_IMAGES_PER_PROPERTY=0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@HouseRentEthiopia
TELEGRAM_ADMIN_CHAT_ID=

# Firebase (FCM)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Payment
LISTING_FEE_ETB=20
LISTING_DURATION_DAYS=90
TELEBIRR_ACCOUNT_NUMBER=0993676861
TELEBIRR_ACCOUNT_NAME=Zekarias
CBE_ACCOUNT_NUMBER=1000262694392
CBE_ACCOUNT_NAME=Zekarias Kobot Koyra

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5584,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
